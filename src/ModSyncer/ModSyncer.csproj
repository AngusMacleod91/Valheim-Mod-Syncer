<?xml version="1.0" encoding="utf-8"?>
<!--
  ModSyncer.csproj  -  the main plugin (runs inside Valheim on both the server and every client).

  A .csproj is a C# project file: it tells the compiler which source files to build, which
  other DLLs to reference, and what to do afterwards. Shared settings live in
  ..\..\Directory.Build.props.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>ModSyncer</AssemblyName>
    <RootNamespace>ModSyncer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Code shared with the patcher project (staging folder locations). -->
    <Compile Include="..\Shared\StagingPaths.cs" Link="Shared\StagingPaths.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- .NET Framework libraries that are not referenced by default. Zip reading lives here. -->
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <ItemGroup>
    <!--
      References to the game and the mod loader. Private=false means "do not copy this DLL next
      to our output" because the game already ships these files.
    -->
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimManaged)\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ValheimManaged)\assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(ValheimManaged)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Generate a tiny C# file holding the version number from Directory.Build.props, so the
    version only has to be typed once. %3B is an escaped semicolon (semicolons split MSBuild lists).
  -->
  <Target Name="GeneratePluginVersion" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <PluginVersionFile>$(IntermediateOutputPath)PluginVersion.g.cs</PluginVersionFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(PluginVersionFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
      Lines="// Generated by ModSyncer.csproj from Directory.Build.props - do not edit.;namespace ModSyncer { internal static class PluginVersion { public const string Value = &quot;$(Version)&quot;%3B public const string ThunderstoreNamespace = &quot;$(ThunderstoreNamespace)&quot;%3B public const string ThunderstoreName = &quot;$(ThunderstoreName)&quot;%3B } }" />
    <ItemGroup>
      <Compile Include="$(PluginVersionFile)" />
    </ItemGroup>
  </Target>

  <!--
    Write a Thunderstore-style manifest.json next to the DLL. The mod recognises installed mods
    by folders that contain one of these, so our own dev copy needs it too.
  -->
  <Target Name="WriteThunderstoreManifest" AfterTargets="Build">
    <WriteLinesToFile File="$(TargetDir)manifest.json" Overwrite="true" WriteOnlyWhenDifferent="true"
      Lines="{;  &quot;name&quot;: &quot;$(ThunderstoreName)&quot;%2C;  &quot;version_number&quot;: &quot;$(Version)&quot;%2C;  &quot;website_url&quot;: &quot;https://github.com/AngusMacleod91/Valheim-Mod-Syncer&quot;%2C;  &quot;description&quot;: &quot;Server-enforced mod list: rejects mismatched clients and downloads the right mod versions for them.&quot;%2C;  &quot;dependencies&quot;: [&quot;denikson-BepInExPack_Valheim-5.4.2202&quot;];}" />
  </Target>

  <!--
    After every build, copy the plugin into the game's BepInEx plugins folder so you can just
    launch Valheim to test. The folder name follows the Author-Name convention used by r2modman.
  -->
  <Target Name="CopyToGame" AfterTargets="WriteThunderstoreManifest" Condition="Exists('$(BepInExDir)\plugins')">
    <ItemGroup>
      <PluginFiles Include="$(TargetPath);$(TargetDir)$(TargetName).pdb;$(TargetDir)manifest.json" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(BepInExDir)\plugins\$(ThunderstoreNamespace)-$(ThunderstoreName)\" />
    <Message Importance="high" Text="ModSyncer plugin copied to $(BepInExDir)\plugins\$(ThunderstoreNamespace)-$(ThunderstoreName)\" />
  </Target>

</Project>
